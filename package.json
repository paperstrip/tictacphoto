{
  "name": "webpackconfig",
  "version": "2.0.0",
  "description": "Web pack config for ES6 / SASS COMPILER",
  "scripts": {
    "dist": " webpack --mode production --config webpack.production.config.js",
    "watch": "webpack --watch --mode development --config webpack.development.config.js",
    "critical": "webpack --mode production --config webpack.critical.config.js",
    "build": "webpack --mode production --config webpack.production.config.js",
    "deploy": "rsync -avz -e 'ssh -p $SSH_PORT' --delete --exclude '_dev' --exclude 'node_modules' --exclude '.git' ../ $DEPLOY_USER@$DEPLOY_HOST:$DEPLOY_PATH"

  },
  "author": "Arnaud Herr © Wibicom",
  "devDependencies": {
    "@babel/core": "^7.20.12",
    "@babel/preset-env": "^7.22.5",
    "@webpack-cli/serve": "^2.0.1",
    "autoprefixer": "^10.4.13",
    "babel-core": "^6.26.3",
    "babel-loader": "^9.1.2",
    "babel-polyfill": "^6.26.0",
    "babel-preset-env": "^1.7.0",
    "compression-webpack-plugin": "^10.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.3",
    "file-loader": "^6.2.0",
    "gsap": "^3.12.5",
    "imports-loader": "^4.0.1",
    "mini-css-extract-plugin": "^2.7.2",
    "move-copy-chunk-webpack-plugin": "^1.0.0",
    "postcss-loader": "^7.0.2",
    "postcss-preset-env": "^7.8.3",
    "sass": "^1.57.1",
    "sass-loader": "^13.2.0",
    "webpack": "^5.88.0",
    "webpack-bundle-analyzer": "^4.7.0",
    "webpack-cli": "^5.0.1",
    "webpack-dev-server": "^4.11.1"
  },
  "dependencies": {
